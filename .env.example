# Rovix Uptime Monitoring -- configuration template.
#
# Copy to .env and fill in real values:   cp .env.example .env
# .env is gitignored; this template is committed and must never hold secrets.
#
# Loaded by env_file.load() at startup (app.py). Real environment variables
# always take precedence, so a container/systemd unit that injects these
# overrides the file -- deploy either way.

# --- SMTP (alert email) ---------------------------------------------------
# Without SMTP_HOST, email_alerts.send() logs "SMTP_HOST not set, skipping"
# and returns False. It does NOT raise -- alerts stop silently. Set these.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@example.com
# Gmail requires an App Password (not the account password) when 2FA is on.
SMTP_PASS=your-app-password
ALERT_FROM=you@example.com

# --- Self-heartbeat (external dead-man's switch) --------------------------
# Rovix can't alert you that IT died, so while alive it pings this URL every
# tick. Create a check at healthchecks.io / Cronitor (or any receiver) with its
# OWN alert if the ping stops. Unset -> disabled.
#HEARTBEAT_URL=https://hc-ping.com/your-uuid
#HEARTBEAT_INTERVAL_SEC=60

# --- Alert channels (in addition to email) -------------------------------
# Alerts fan out to EVERY configured channel. Leave unset to skip a channel.
# Slack/Discord: an incoming-webhook URL (both accept {"text": ...}).
#SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ
# Generic receiver: gets POST {"subject": ..., "body": ...} as JSON.
#ALERT_WEBHOOK_URL=https://example.com/hooks/rovix

# --- Dashboard ------------------------------------------------------------
# Public URL of this dashboard. Used to build the "view dashboard" link in
# alert emails -- unset means that link is missing/broken in every alert.
DASHBOARD_URL=https://monitoring.example.com

# --- Optional -------------------------------------------------------------
# Fallback alert recipients, comma-separated. Ignored whenever recipients are
# set in the dashboard's Settings modal (the normal case).
#ALERT_TO=alerts@example.com

# Enables the REST API in api.py. Every /monitors route returns 503 until set.
#API_KEY=generate-a-long-random-string

# Website/CRM/API response slower than this (ms) for 2 consecutive checks opens
# a warning "slow response" incident (separate from up/down). Default 3000.
#LATENCY_WARN_MS=3000

# Domain-registration expiry (domain_check.py, via RDAP -- no WHOIS dependency).
# Warn this many days before a monitored domain's registration lapses. Default 30.
#DOMAIN_WARN_DAYS=30
#DOMAIN_CHECK_INTERVAL_SEC=86400

# DNS A/AAAA-record change detection (dns_check.py) -- a hijack/misconfig signal.
# OPT-IN: best for stable-IP hosting (your WHM servers); a CDN that rotates IPs
# would alert on each rotation. One WARNING per distinct change, then rebaselines.
#DNS_CHANGE_ALERTS=0
#DNS_CHANGE_INTERVAL_SEC=3600

# Pins login sessions across restarts. Unset means a random key per start,
# which logs everyone out on every restart.
#SESSION_SECRET_KEY=generate-a-long-random-string

# --- WHM / cPanel remote server health (whm_health.py) --------------------
# Watches the REMOTE cPanel servers the client sites live on (disk/CPU/memory/
# mail queue) via the WHM API -- a remote server filling up can break the app
# while HTTP still returns 200. Alerts reuse the SMTP settings above and the
# same recipient list. Unset WHM_SERVERS -> the whole feature is dormant.
#
# Servers to watch, comma-separated host:token pairs. The token is a SCOPED,
# READ-ONLY WHM API token (NOT root) -- see the PRD §7 admin handoff. Secret:
# keep it in the real .env / a secrets manager, never in source control.
#WHM_SERVERS=server1.example.com:WHMAPITOKEN1,server2.example.com:WHMAPITOKEN2
#WHM_USER=root
#WHM_PORT=2087
#WHM_CHECK_INTERVAL_SEC=60
# Per-call WHM API timeout (seconds).
#WHM_TIMEOUT_SEC=15
# Verification is ON by default; set this only if the WHM control port uses a
# self-signed cert.
#WHM_INSECURE_TLS=0
# Thresholds (percent; PRD §6 defaults 80/90).
#WHM_DISK_WARN=80
#WHM_DISK_CRIT=90
#WHM_CPU_WARN=80
#WHM_CPU_CRIT=90
#WHM_MEM_WARN=80
#WHM_MEM_CRIT=90
# CPU is reported as load average; set the server's core count to turn it into
# a percent. Unset -> CPU is skipped (we don't guess a core count).
#WHM_CPU_CORES=4
# Auto-discovery: pull every site on each WHM server and create an uptime+SSL
# monitor for it automatically (idempotent; never deletes). Runs hourly.
#WHM_DISCOVERY_INTERVAL_SEC=3600
#WHM_DISCOVERY_FUNCTION=listaccts
# PRD §8 open items -- the exact WHM functions are unconfirmed, so these metrics
# stay dormant until the WHM-admin dev confirms the function names.
#WHM_MEM_FUNCTION=
#WHM_MAILQ_FUNCTION=

# Security-alert surfacing (whm_security.py): relay the server's OWN security
# tools into Rovix. Each is dormant until its WHM/plugin function is confirmed
# by the admin. Malware alerts on ANY detection; the others on a count threshold.
#WHM_IMUNIFY_FUNCTION=
#WHM_MODSEC_FUNCTION=
#WHM_CPHULK_FUNCTION=
#WHM_MODSEC_THRESHOLD=50
#WHM_CPHULK_THRESHOLD=20
#WHM_SECURITY_INTERVAL_SEC=300
# Mail queue is a raw count with no universal baseline (PRD §8 #2) -- measure
# the typical queue size and confirm these with the PM before enabling.
#WHM_MAILQ_WARN=500
#WHM_MAILQ_CRIT=1000
